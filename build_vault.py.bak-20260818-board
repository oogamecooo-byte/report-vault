#   보고서 전용. 어느 스킬 산출물인지는 <meta name="vault-skill">로 구분(예: Deep-Dive).

# 루틴(정기 모니터링) 단계 — 날짜 묶음 안에서 접이식 한 줄로 압축된다. 매일 쌓이는 daily/weekly가 목록을 덮는 것 방지.
ROUTINE_STAGE = "Monitoring"
DAY_GROUP_WINDOW = 45      # 최근 N일 = 날짜(일)별 묶음 / 그보다 오래된 것 = 월별 묶음
AUTO_TOPIC_MIN = 2         # 사이드바 "주제" 자동 생성 최소 건수(1건짜리는 검색으로)
WD = "월화수목금토일"

# 폴더 섹션 — topic/topics/skill + (선택)stage 조건 복합 필터. 추가/교체는 여기만.
#   group: 사이드바 소제목(종목/테마/형식) · topic: 그 주제만 / topics: 여러 주제 중 하나(OR)
#   skill_is: 그 스킬 산출물만 · stage_is·stage_not: 단계 조건 (미지정 조건은 전체 통과)
PINNED = [
    {"group": "종목", "label": "IREN 인프라", "badge": "IREN", "color": "#1E5F45", "topic": "IREN 인프라"},
    {"group": "종목", "label": "IREN 중요",  "badge": "IREN", "color": "#2F7D5B", "topic": "IREN", "stage_not": "Monitoring"},
    {"group": "종목", "label": "IREN 루틴",  "badge": "IREN", "color": "#6FA98C", "topic": "IREN", "stage_is": "Monitoring"},
    {"group": "종목", "label": "SECZ 중요",  "badge": "SECZ", "color": "#8A6D2F", "topic": "SECZ", "stage_not": "Monitoring"},
    {"group": "종목", "label": "SECZ 루틴",  "badge": "SECZ", "color": "#B79A5E", "topic": "SECZ", "stage_is": "Monitoring"},
    # 테마 폴더 — 양자(2026-07-23)·광학(2026-07-24). 순수 주제 + 관련 종목/산업 topic OR-매칭.
    {"group": "테마", "label": "양자", "badge": "Q", "color": "#7A3FBF", "topics": ["양자", "INFQ", "IONQ", "LAES"]},
