    {"group": "형식", "label": "Deep-Dive", "badge": "DIVE", "color": "#1F6F8B", "skill_is": "Deep-Dive"},
]
PIN_GROUPS = ["종목", "테마", "형식"]


def pin_match(i, p):
    ts = i.get("topics") or [i["topic"]]          # 보조 주제(vault-topics) 포함 — 한 보고서가 두 폴더에 동시 소속 가능
    if p.get("topic") and p["topic"] not in ts:
        return False
    if p.get("topics") and not (set(p["topics"]) & set(ts)):
        return False
    if p.get("skill_is") and i.get("skill") != p["skill_is"]:
        return False
    if p.get("stage_is") and i["stage"] != p["stage_is"]:
        return False
    if p.get("stage_not") and i["stage"] == p["stage_not"]:
        return False
    return True


def get_meta(txt: str, name: str) -> str:
    m = re.search(rf'<meta\s+name=["\']{name}["\']\s+content=["\']([^"\']*)["\']', txt, re.I)
    if not m:
        m = re.search(rf'<meta\s+content=["\']([^"\']*)["\']\s+name=["\']{name}["\']', txt, re.I)
    return m.group(1).strip() if m else ""


def collect():
    items = []
    if not REPORTS.exists():
        return items
    for p in sorted(REPORTS.glob("*.html")):
        txt = p.read_text(encoding="utf-8", errors="ignore")[:30000]
        tm = re.search(r"<title>([^<]*)</title>", txt, re.I)
        title = (tm.group(1).strip() if tm else "") or p.stem
        title = re.sub(r"\s*\|\s*20\d{2}-\d{2}-\d{2}\s*$", "", title)
        stage = get_meta(txt, "vault-stage").capitalize()
        if stage not in STAGES:
            stage = "Research"
        date = get_meta(txt, "vault-date")
        if not date:
            dm = re.search(r"(20\d{2}-\d{2}-\d{2})", p.name)
            date = dm.group(1) if dm else ""
        summary = get_meta(txt, "description") or "요약 없음"
        topic = get_meta(txt, "vault-topic") or get_meta(txt, "vault-series") or "기타"
        # 🆕 2026-08-16 보조 주제(vault-topics, 쉼표/| 구분) — 형식 폴더(어닝콜 등)에 있으면서
        #    종목 폴더([SECZ 중요] 등)에도 같이 걸려야 하는 보고서용. 카드 표시·정렬은 주 topic 기준 그대로.
        extra = [t.strip() for t in re.split(r"[,|]", get_meta(txt, "vault-topics")) if t.strip()]
        topics = [topic] + [t for t in extra if t != topic]
        skill = get_meta(txt, "vault-skill")
        # 발행일이 기준일(vault-date)과 다를 때만 카드에 병기 — 같은 날이면 노이즈라 비운다.
        pub = get_meta(txt, "vault-published")
        if pub == date:
            pub = ""
        items.append({"file": p.name, "title": title, "stage": stage, "date": date, "summary": summary,
                      "topic": topic, "topics": topics, "skill": skill, "pub": pub})
    items.sort(key=lambda x: (x["date"], x["file"]), reverse=True)
    return items


# ── 날짜 묶음 ────────────────────────────────────────────────────────────────
def group_of(ds, today):
    """(묶음키, 라벨, 종류) — 최근 DAY_GROUP_WINDOW일은 일별, 그 이전은 월별, 날짜 없으면 별도 묶음."""
    try:
        d = datetime.date.fromisoformat(ds)
    except ValueError:
        return ("nodate", "날짜 미상", "none")
    if (today - d).days <= DAY_GROUP_WINDOW:
        return (ds, f"{d.month}월 {d.day}일 ({WD[d.weekday()]})", "day")
    return (ds[:7], f"{d.year}년 {d.month}월", "month")


def build_groups(items, today):
    order, idx = [], {}
    for i in items:                       # items 는 이미 날짜 내림차순 → 묶음 순서도 자연히 최신순
        k, lab, kind = group_of(i["date"], today)
        if k not in idx:
            idx[k] = {"key": k, "label": lab, "kind": kind, "main": [], "routine": []}
            order.append(idx[k])
        idx[k]["routine" if i["stage"] == ROUTINE_STAGE else "main"].append(i)
    return order


def pub_html(ds):
    """발행일 병기 — '발행 M/D'. 기준일과 다를 때만 collect()가 값을 채운다."""
    if not ds:
        return ""
    try:
        d = datetime.date.fromisoformat(ds)
    except ValueError:
        return ""
    return f'<span class="pub" title="vault 발행일 {ds} (카드 날짜는 보고서 기준일)">발행 {d.month}/{d.day}</span>'


def card_html(i):
    return (f'<a class="card" data-stage="{i["stage"]}" data-topic="{html.escape(i["topic"])}"'
            f' data-topics="{html.escape("|".join(i.get("topics") or [i["topic"]]))}"'
            f' data-skill="{html.escape(i.get("skill", ""))}" href="reports/{html.escape(i["file"])}">\n'
            f'  <div class="row"><span class="bd sm" style="background:{BADGE_COLOR[i["stage"]]}">{BADGE[i["stage"]]}</span>\n'
            f'  <span class="meta">{i["stage"]}{" · " + html.escape(i["skill"]) if i.get("skill") else ""} · {html.escape(i["topic"])}</span>'
            f'<span class="date">{i["date"]}</span>{pub_html(i.get("pub", ""))}</div>\n'
            f'  <div class="title">{html.escape(i["title"])}</div>\n'
            f'  <div class="sum">{html.escape(i["summary"])}</div>\n</a>')


def render(items):
    counts = {s: sum(1 for i in items if i["stage"] == s) for s in STAGES}
    today = datetime.date.today()

    # ── 사이드바: 단일 선택(라디오) · 아코디언 3섹션 ──
    nav = [f'<button class="nav all active" data-kind="all"><span class="nm">전체</span><span class="ct">{len(items)}</span></button>']

    # 폴더는 기본 펼침(2026-07-30 사용자 지시 — "폴더 항목은 기본적으로 열려있게"),
    # 주제·분류는 접힘 유지(2026-07-26 지시) — 첫 화면 = 전체 + 펼친 폴더 + 접힌 2줄 + 날짜 줄
    nav.append(f'<details class="sec" open><summary class="grp">폴더<span class="gc">{len(PINNED)}</span></summary>')
    for g in PIN_GROUPS:
        pins = [p for p in PINNED if p.get("group", "종목") == g]
        if not pins:
            continue
        nav.append(f'<div class="ssub">{g}</div>')
        for p in pins:
            c = sum(1 for i in items if pin_match(i, p))
            nav.append(f'<button class="nav pin" data-kind="pin" data-topic="{html.escape(p.get("topic", ""))}"'
                       f' data-topics="{html.escape("|".join(p.get("topics", [])))}"'
                       f' data-skill-is="{html.escape(p.get("skill_is", ""))}"'
                       f' data-stage-is="{p.get("stage_is", "")}" data-stage-not="{p.get("stage_not", "")}">'
                       f'<span class="bd" style="background:{p["color"]}">{p["badge"]}</span>'
                       f'<span class="nm">{p["label"]}</span><span class="ct">{c}</span></button>')
    nav.append('</details>')

    # 주제 — PINNED 가 이미 흡수한 topic 을 뺀 나머지를 건수순 자동 생성(손으로 탭 추가할 필요 없음)
    pinned_topics = set()
    for p in PINNED:
        if p.get("topic"):
            pinned_topics.add(p["topic"])
        pinned_topics.update(p.get("topics", []))
    tc = {}
    for i in items:
        for t in (i.get("topics") or [i["topic"]]):     # 보조 주제도 같은 자격으로 계수(폴더/탭 카운트 일치)
            tc[t] = tc.get(t, 0) + 1
    autos = sorted(((t, n) for t, n in tc.items() if t not in pinned_topics and n >= AUTO_TOPIC_MIN),
                   key=lambda x: (-x[1], x[0]))
    if autos:
        nav.append(f'<details class="sec"><summary class="grp">주제<span class="gc">{len(autos)}</span></summary>')
        for t, n in autos:
            nav.append(f'<button class="nav" data-kind="topic" data-value="{html.escape(t)}">'
                       f'<span class="nm">{html.escape(t)}</span><span class="ct">{n}</span></button>')
        nav.append(f'<div class="note">{AUTO_TOPIC_MIN}건 이상인 주제만 표시 — 나머지는 검색으로</div></details>')

    nav.append(f'<details class="sec"><summary class="grp">분류<span class="gc">{len(STAGES)}</span></summary>')
    for s in STAGES:                    # 0건 단계도 항상 표시 — 분류 기준은 고정 노출 (2026-07-23 사용자 지적)
        nav.append(f'<button class="nav" data-kind="stage" data-value="{s}">'
                   f'<span class="bd" style="background:{BADGE_COLOR[s]}">{BADGE[s]}</span>'
                   f'<span class="nm">{s}</span><span class="ct">{counts[s]}</span></button>')
    nav.append('</details>')
    navbar = "\n".join(nav)

    # ── 본문: 날짜 묶음 → (읽을거리 카드) + (그날 루틴 접이식) ──
    if items:
        blocks = []
        for g in build_groups(items, today):
            body = "".join(card_html(i) for i in g["main"])
            if g["routine"]:
                body += ('<details class="rt"><summary><span class="rl">루틴 기록</span>'
                         f'<span class="rc">{len(g["routine"])}건</span></summary><div class="rb">'
                         + "".join(card_html(i) for i in g["routine"]) + '</div></details>')
            n = len(g["main"]) + len(g["routine"])
            # 날짜 묶음도 접이식 — 전체 목록에서는 기본 접힘(날짜 줄만 보임), 클릭해 펼침.
            #   걸러 본 상태(폴더·분류·주제·검색)에서는 apply()가 자동으로 펼친다.
            blocks.append(f'<details class="dg" data-date="{g["key"]}" data-kind="{g["kind"]}">'
                          f'<summary class="dh"><span class="dl">{g["label"]}</span><span class="dc">{n}건</span></summary>'
                          f'<div class="db">{body}</div></details>')
        cards = "".join(blocks)
    else:
        cards = '<div class="empty">아직 등재된 보고서가 없습니다 — 첫 보고서가 곧 올라옵니다.</div>'
    built = datetime.date.today().isoformat()
