BADGE_COLOR = {"Monitoring": "#2f9e8f", "Macro": "#4da3d8", "Discovery": "#4fc08d", "Research": "#a98ee0", "Analysis": "#e06c5f", "Dive": "#1F6F8B", "Thesis": "#d4af5a"}
