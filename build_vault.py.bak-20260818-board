</style></head>
<body><div class="wrap">
<div class="hd"><div class="kicker">STRUCTURE &amp; BOTTLENECKS</div><h1>Report Vault</h1>
<p>매크로·산업·기업 분석 기록을 모아 읽는 보고서 자료실.</p></div>
<div class="layout">
<aside id="nav">{navbar}</aside>
<main>
<input id="q" placeholder="검색 (제목 · 요약 · 티커)">
<div class="bar"><span class="now" id="now">전체</span><span class="cnt" id="cnt"></span></div>
<div id="list">{cards}</div>
<footer>본 자료실의 모든 보고서는 정보 정리·분석 목적이며 투자 권유가 아닙니다.<br>index built {built} · read-only</footer>
</main>
</div>
</div>
<script>
const navs=[...document.querySelectorAll('.nav')],cards=[...document.querySelectorAll('.card')],
      dgs=[...document.querySelectorAll('.dg')],q=document.getElementById('q'),
      now=document.getElementById('now'),cnt=document.getElementById('cnt');
let sel={{kind:'all',label:'전체'}};

// 오늘/어제는 열람 시점 기준으로 다시 붙인다(빌드 시점에 굳히면 며칠 뒤 열 때 틀림)
(function(){{
  const iso=d=>d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
  const t=new Date(), y=new Date(); y.setDate(y.getDate()-1);
  const map={{[iso(t)]:'오늘',[iso(y)]:'어제'}};
  dgs.forEach(g=>{{
    if(g.dataset.kind!=='day') return;
    const w=map[g.dataset.date]; if(!w) return;
    const el=g.querySelector('.dl'); el.textContent=w+' · '+el.textContent;
  }});
}})();

// 카드의 주제 목록 — 주 topic + 보조(vault-topics). 폴더·주제 선택은 이 목록 안에 있으면 통과.
const tps=c=>(c.dataset.topics||c.dataset.topic||'').split('|');
function okSel(c){{
  if(sel.kind==='all') return true;
  if(sel.kind==='stage') return c.dataset.stage===sel.value;
  if(sel.kind==='topic') return tps(c).includes(sel.value);
  if(sel.kind==='pin'){{
    if(sel.topic && !tps(c).includes(sel.topic)) return false;
    if(sel.topics && !sel.topics.split('|').some(t=>tps(c).includes(t))) return false;
    if(sel.skillIs && c.dataset.skill!==sel.skillIs) return false;
    if(sel.stageIs && c.dataset.stage!==sel.stageIs) return false;
    if(sel.stageNot && c.dataset.stage===sel.stageNot) return false;
    return true;
  }}
  return true;
}}
function apply(){{
  const t=q.value.trim().toLowerCase();let n=0;
  cards.forEach(c=>{{
    const okT = !t || c.textContent.toLowerCase().includes(t) || (c.dataset.topics||c.dataset.topic||'').toLowerCase().includes(t);
    const show = okSel(c) && okT; c.style.display = show?'':'none'; if(show)n++;
  }});
  const narrowed = !!t || sel.kind!=='all';
  dgs.forEach(g=>{{
    const rt=g.querySelector('.rt');
    if(rt){{
      let rv=0; rt.querySelectorAll('.card').forEach(c=>{{if(c.style.display!=='none')rv++;}});
      rt.style.display=rv?'':'none'; rt.querySelector('.rc').textContent=rv+'건';
      rt.open=narrowed;                     // 걸러 본 상태면 루틴도 펼침 · 전체로 돌아오면 다시 접힘
    }}
    let v=0; g.querySelectorAll('.card').forEach(c=>{{if(c.style.display!=='none')v++;}});
    g.style.display=v?'':'none'; g.querySelector('.dc').textContent=v+'건';
    g.open=narrowed;                        // 전체 목록=접힘(기본) · 걸러 본 상태=펼침
  }});
  now.textContent = sel.label; cnt.textContent = n+'건';
}}
navs.forEach(b=>b.onclick=()=>{{
  navs.forEach(x=>x.classList.remove('active')); b.classList.add('active');
  sel={{kind:b.dataset.kind, value:b.dataset.value||null,
        topic:b.dataset.topic||null, topics:b.dataset.topics||null, skillIs:b.dataset.skillIs||null,
        stageIs:b.dataset.stageIs||null, stageNot:b.dataset.stageNot||null,
        label:(b.querySelector('.nm')?.textContent||'전체')}};
  apply();
}});
q.oninput=apply;
apply();
if('serviceWorker' in navigator){{navigator.serviceWorker.register('sw.js').catch(function(){{}});}}
</script></body></html>'''


def _restore_collapsible(t):
    t = re.sub(r'<p>\s*(&lt;details&gt;.*?&lt;/summary&gt;)\s*</p>', r'\1', t, flags=re.S)
    t = re.sub(r'<p>\s*(&lt;/details&gt;)\s*</p>', r'\1', t)
    for a, b in (('&lt;details&gt;', '<details>'), ('&lt;summary&gt;', '<summary>'),
                 ('&lt;/summary&gt;', '</summary>'), ('&lt;/details&gt;', '</details>')):
        t = t.replace(a, b)
    return t


def normalize_reports():
    # 🔴 2026-07-22 발행 경로 무관 최종 백스톱 — 빌드 시(=모든 발행 시) reports/ 전수 정규화.
    #   변환기/스킬/즉석코드 어디서 이스케이프됐든 vault 반영 전 접이식 <details> 복원(재발 원천 차단).
    n = 0
    for p in REPORTS.glob("*.html"):
        t = p.read_text(encoding="utf-8", errors="ignore")
        if "&lt;details&gt;" in t or "&lt;summary&gt;" in t:
            p.write_text(_restore_collapsible(t), encoding="utf-8"); n += 1
    if n:
        print(f"  🔧 접이식 정규화: {n}편 복원")


if __name__ == "__main__":
    normalize_reports()
    items = collect()
    (ROOT / "index.html").write_text(render(items), encoding="utf-8")
    print(f"index.html 생성 완료 — 보고서 {len(items)}건")
