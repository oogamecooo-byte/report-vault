def log(msg):
    ts = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    with open(LOG, "a", encoding="utf-8") as f:
        f.write(f"[{ts}] {msg}\n")


def load_manifest():
    if MANIFEST.exists():
        try:
            return json.loads(MANIFEST.read_text(encoding="utf-8"))
        except Exception:
            return {}
    return {}


def slugify(name):
    s = re.sub(r"\.html?$", "", name)
    s = re.sub(r"20\d\d[-_]\d\d[-_]\d\d", "", s).lower()   # 날짜 제거(파일명 앞에 별도 부착)
    s = re.sub(r"[^0-9a-z가-힣]+", "-", s).strip("-")       # 언더스코어 포함 비영숫자 → 하이픈
    return s or "report"


def find_date(name):
    m = re.search(r"(20\d\d)[-_](\d\d)[-_](\d\d)", name)
    if m:
        return f"{m.group(1)}-{m.group(2)}-{m.group(3)}"
    return datetime.date.today().isoformat()


def has_meta(txt, name):
    return re.search(rf'<meta\s+name=["\']{name}["\']', txt, re.I) is not None


def inject_meta(txt, stage, topic, date, title, skill=None):
    """vault 메타가 없으면 <head>(또는 최상단)에 주입. 이미 있으면 그 값 유지."""
    add = []
    if not has_meta(txt, "vault-stage"):
        add.append(f'<meta name="vault-stage" content="{stage}">')
    if not has_meta(txt, "vault-topic"):
        add.append(f'<meta name="vault-topic" content="{topic}">')
    if skill and not has_meta(txt, "vault-skill"):
        add.append(f'<meta name="vault-skill" content="{skill}">')
    if not has_meta(txt, "vault-date"):
        add.append(f'<meta name="vault-date" content="{date}">')
    # 발행일(= 이 훅이 도는 날). vault-date는 '보고서 기준일'이라 둘이 어긋날 수 있고
    # (예: 7/30에 만든 7/29 FOMC 회견 완역), 카드에 '발행 M/D'로 병기해 어긋남을 보이게 한다.
    if not has_meta(txt, "vault-published"):
        add.append(f'<meta name="vault-published" content="{datetime.date.today().isoformat()}">')
    if not has_meta(txt, "description"):
        desc = re.sub(r'["\']', "", title)[:120]
        add.append(f'<meta name="description" content="{desc}">')
    if not has_meta(txt, "robots"):
        add.append('<meta name="robots" content="noindex, nofollow">')
    if not add:
        return txt
    block = "\n".join(add) + "\n"
    if re.search(r"</head>", txt, re.I):
        return re.sub(r"</head>", block + "</head>", txt, count=1, flags=re.I)
    if re.search(r"</title>", txt, re.I):
        return re.sub(r"(</title>)", r"\1\n" + block, txt, count=1, flags=re.I)
    return block + txt          # <head> 없는 조각 HTML → 최상단


def check_banned(txt):
    for pat, why in BANNED:
        if re.search(pat, txt):
            return why
    return None


def _clean_title(s):
    s = re.sub(r"<[^>]+>", "", s)                          # 내부 태그(<strong> 등) 제거
    s = re.sub(r"[*_`]+", "", s)                            # 마크다운 잔재
    s = re.sub(r"^[\s←-⯿️\U0001F000-\U0001FAFF]+", "", s)  # 선두 이모지/기호/공백
    return re.sub(r"\s+", " ", s).strip()


def get_title(txt, fallback):
    # 🔴 2026-07-22 — H1 우선. 변환기가 남긴 stale <title>(예: SECZ "주간 심층 분석 — 6/06")보다
    #   보고서 본문 <h1>이 항상 정확·날짜 포함. 이모지·태그·마크다운 제거 후 사용. (없으면 <title>→파일명)
    h = re.search(r"<h1[^>]*>(.*?)</h1>", txt, re.I | re.S)
    if h:
        t = _clean_title(h.group(1))
        if len(t) >= 4:
            return t
    m = re.search(r"<title>([^<]*)</title>", txt, re.I)
    return (m.group(1).strip() if m else "") or fallback


def restore_collapsible(txt):
    # 🔴 2026-07-22 — 여러 md2html 변환기가 html.escape로 raw <details>/<summary>를 이스케이프해
    #   접이식 "배경" 섹션이 리터럴 텍스트로 표시되는 버그 복원. 정확히 이 4개 태그만 안전 복원(+ <p> 래퍼 제거).
    txt = re.sub(r'<p>\s*(&lt;details&gt;.*?&lt;/summary&gt;)\s*</p>', r'\1', txt, flags=re.S)
    txt = re.sub(r'<p>\s*(&lt;/details&gt;)\s*</p>', r'\1', txt)
    for a, b in (('&lt;details&gt;', '<details>'), ('&lt;summary&gt;', '<summary>'),
                 ('&lt;/summary&gt;', '</summary>'), ('&lt;/details&gt;', '</details>')):
        txt = txt.replace(a, b)
    return txt


def set_title(txt, title):
    # 게시본 <title>을 H1 도출 제목으로 정규화(stale <title> 교체) → build_vault 카드·브라우저 탭 일치.
    esc = title.replace("<", "").replace(">", "")
    if re.search(r"<title>.*?</title>", txt, re.I | re.S):
        return re.sub(r"<title>.*?</title>", f"<title>{esc}</title>", txt, count=1, flags=re.I | re.S)
    if re.search(r"</head>", txt, re.I):
        return re.sub(r"</head>", f"<title>{esc}</title></head>", txt, count=1, flags=re.I)
    return f"<title>{esc}</title>\n" + txt


def main():
    manifest = load_manifest()
    published, blocked = [], []

    for rel, glob, stage, topic in ALLOWLIST:
        d = DOC / rel
        if not d.is_dir():
            continue
        for src in sorted(d.glob(glob)):
            key = str(src)
            mtime = src.stat().st_mtime
            if manifest.get(key, {}).get("mtime") == mtime:
                continue                                   # 변화 없음 → skip
            txt = src.read_text(encoding="utf-8", errors="ignore")
            why = check_banned(txt)
            if why:
                manifest[key] = {"mtime": mtime, "status": "blocked", "why": why}
                blocked.append(f"{rel}/{src.name} ({why})")
                continue
            date = find_date(src.name)
            title = get_title(txt, src.stem)
            # 특례: IREN 인프라 현황 = evergreen → 전용 topic + 고정 이름(날짜 없음·항상 같은 URL)
            if "Infrastructure_Status" in src.name:
                topic_use, stage_use, destname = "IREN 인프라", "Analysis", "iren-infrastructure"
            else:
                topic_use, stage_use, destname = topic, stage, f"{date}_{slugify(src.name)}"
                if date not in title:            # H1이 날짜를 빠뜨렸으면 파일명 날짜 부착(카드 제목 날짜 보장)
                    title = f"{title} — {date}"
            out = inject_meta(txt, stage_use, topic_use, date, title)
            out = set_title(out, title)          # 🔴 게시본 <title> 정규화(H1 도출·stale 교체)
            out = restore_collapsible(out)       # 🔴 이스케이프된 <details>/<summary> 접이식 복원
            dest = REPORTS / f"{destname}.html"
            if not DRY:
                dest.write_text(out, encoding="utf-8")
                manifest[key] = {"mtime": mtime, "status": "published", "dest": dest.name}
            published.append(dest.name)

    # ── Dive 계열 (stage=Dive · vault-skill 주입 · nested=티커폴더 / flat=평면 파일명)
    for rel, skill, layout in DIVE_ALLOWLIST:
        base = DOC / rel
        if not base.is_dir():
            continue
        srcs = base.glob("*/*.html") if layout == "nested" else base.glob("*.html")
        for src in sorted(srcs):
            if layout == "nested":
                topic = src.parent.name                                    # 폴더명 = 티커
            else:                                                          # flat: {티커}_{date} → 앞토큰
                topic = re.split(r"_?20\d\d[-_]\d\d[-_]\d\d", src.stem)[0].strip("_") or src.stem.split("_")[0]
            if topic in DIVE_TOPIC_SKIP or src.stem in DIVE_TOPIC_SKIP:
                continue
            key = str(src)
            mtime = src.stat().st_mtime
            if manifest.get(key, {}).get("mtime") == mtime:
                continue                            # seed 포함 — 변화 없으면 skip(과거분 자동 차단)
            txt = src.read_text(encoding="utf-8", errors="ignore")
            why = check_banned(txt)
            if why:
                if not DRY:
                    manifest[key] = {"mtime": mtime, "status": "blocked", "why": why}
                blocked.append(f"{rel}/{topic}/{src.name} ({why})")
                continue
            date = find_date(src.name)
            title = get_title(txt, src.stem)
            if date not in title:
                title = f"{title} — {date}"
            out = inject_meta(txt, "Dive", topic, date, title, skill=skill)
            out = set_title(out, title)
            out = restore_collapsible(out)
            dest = REPORTS / f"{date}_{slugify(src.name)}.html"
            if not DRY:
                dest.write_text(out, encoding="utf-8")
                manifest[key] = {"mtime": mtime, "status": "published", "dest": dest.name}
            published.append(f"[{skill}/{topic}] {dest.name}")

    if DRY:
        log("DRY-RUN 발행대상 %d건: %s | 차단 %d건: %s"
            % (len(published), ", ".join(published) or "(없음)", len(blocked), ", ".join(blocked) or "(없음)"))
        print("DRY-RUN 발행대상 %d건:" % len(published))
        for x in published:
            print("  +", x)
        print("DRY-RUN 차단 %d건:" % len(blocked))
        for x in blocked:
            print("  ✗", x)
        return

    MANIFEST.write_text(json.dumps(manifest, ensure_ascii=False, indent=1), encoding="utf-8")

    if blocked:
        log("차단(개인정보 패턴): " + " / ".join(blocked))
    if not published:
        return

    # 안전 게이트(하드 백스톱) → 실패 시 발행 중단(원인 로그)
    gate = subprocess.run([sys.executable, str(VAULT / "check_publication_safety.py")],
                          capture_output=True, text=True)
    if gate.returncode != 0:
        log("안전 게이트 실패 — 발행 중단:\n" + gate.stdout[-1500:])
        return

    subprocess.run([sys.executable, str(VAULT / "build_vault.py")], capture_output=True, text=True)
    try:
        subprocess.run(["git", "-C", str(VAULT), "add", "-A"], check=True, capture_output=True)
        subprocess.run(["git", "-C", str(VAULT), "commit", "-m",
                        f"자동 발행 {len(published)}건: {', '.join(published[:4])}"],
                       check=True, capture_output=True)
        subprocess.run(["git", "-C", str(VAULT), "push", "origin", "main"],
                       check=True, capture_output=True, timeout=120)
        log(f"발행 성공 {len(published)}건: {', '.join(published)}")
    except Exception as e:
        log(f"git push 실패: {e}")


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        try:
            log(f"훅 예외: {e}")
        except Exception:
            pass
    sys.exit(0)          # 세션 종료를 절대 막지 않음
